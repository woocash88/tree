rules_version = '2';

// Reguły dostępu serwisu „Przodkowie”. Wdrażane razem ze stroną (workflow) albo wklejane w konsoli Firebase.
// Model: właściciel drzewa i kolaboranci edytują dane; „dane/publiczne” to kopia okrojona wg polityki dat
// (żyjące osoby), „dane/pelne” widzą tylko zarządzający. Administrator = dokument admini/{uid}
// (tworzony ręcznie w konsoli – klient nie może go zapisać).
service cloud.firestore {
  match /databases/{database}/documents {

    function zalogowany() { return request.auth != null; }
    function jestAdmin() { return zalogowany() && exists(/databases/$(database)/documents/admini/$(request.auth.uid)); }
    function zablokowany() { return zalogowany() && exists(/databases/$(database)/documents/blokady/$(request.auth.uid)); }
    // Zapisy do wspólnych danych wymagają potwierdzonego adresu e-mail (Google potwierdza go automatycznie).
    function weryfikowany() { return zalogowany() && request.auth.token.email_verified == true && !zablokowany(); }
    function tekst(v, maks) { return v is string && v.size() <= maks; }
    function niepusty(v, maks) { return v is string && v.size() > 0 && v.size() <= maks; }

    // ── administratorzy i blokady ──
    match /admini/{uid} {
      allow get: if zalogowany() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /blokady/{uid} {
      allow get: if zalogowany() && (request.auth.uid == uid || jestAdmin());
      allow list, write: if jestAdmin();
    }

    // ── profile użytkowników (prywatne) ──
    match /uzytkownicy/{uid} {
      allow get: if zalogowany() && (request.auth.uid == uid || jestAdmin());
      allow list: if jestAdmin();
      allow create: if zalogowany() && !zablokowany() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['imie', 'nazwisko', 'email', 'utworzono'])
        && request.resource.data.keys().hasAll(['imie', 'nazwisko', 'email', 'utworzono'])
        && niepusty(request.resource.data.imie, 80) && niepusty(request.resource.data.nazwisko, 80)
        && request.resource.data.email == request.auth.token.email
        && tekst(request.resource.data.utworzono, 40);
      // Imię, nazwisko i adres e-mail; adres musi być taki jak w tokenie logowania (Firebase zmienia go po potwierdzeniu nowego adresu).
      allow update: if (zalogowany() && !zablokowany() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imie', 'nazwisko', 'email'])
        && niepusty(request.resource.data.imie, 80) && niepusty(request.resource.data.nazwisko, 80)
        && request.resource.data.email == request.auth.token.email) || jestAdmin();
      allow delete: if zalogowany() && (request.auth.uid == uid || jestAdmin());
    }

    // ── wyszukiwanie kolaboranta po adresie e-mail (tylko pojedynczy odczyt, bez listowania) ──
    match /adresy/{email} {
      allow get: if weryfikowany();
      allow list: if false;
      allow create: if weryfikowany() && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid', 'nazwa'])
        && request.resource.data.uid == request.auth.uid && tekst(request.resource.data.nazwa, 170);
      allow update: if weryfikowany() && resource.data.uid == request.auth.uid && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid', 'nazwa'])
        && request.resource.data.uid == request.auth.uid && tekst(request.resource.data.nazwa, 170);
      allow delete: if zalogowany() && (resource.data.uid == request.auth.uid || jestAdmin());
    }

    // ── prośby o dołączenie do drzewa jako kolaborant (zatwierdza właściciel) ──
    // Dokument prosby/{idDrzewa}_{uid}. Prośbę może zgłosić zweryfikowany użytkownik dla istniejącego drzewa,
    // którego nie jest właścicielem ani kolaborantem; widzi ją autor, właściciel drzewa i administrator.
    function wlascicielDrzewa(idDrzewa) {
      return zalogowany() && get(/databases/$(database)/documents/drzewa/$(idDrzewa)).data.wlascicielId == request.auth.uid;
    }
    function prosbaPoprawna(pid, p) {
      return p.keys().hasOnly(['drzewoId', 'uid', 'nazwa', 'utworzono'])
        && p.keys().hasAll(['drzewoId', 'uid', 'nazwa', 'utworzono'])
        && p.uid == request.auth.uid && tekst(p.drzewoId, 128) && pid == p.drzewoId + '_' + p.uid
        && niepusty(p.nazwa, 170) && tekst(p.utworzono, 40)
        && exists(/databases/$(database)/documents/drzewa/$(p.drzewoId))
        && get(/databases/$(database)/documents/drzewa/$(p.drzewoId)).data.wlascicielId != request.auth.uid
        && !(request.auth.uid in get(/databases/$(database)/documents/drzewa/$(p.drzewoId)).data.kolaboranci);
    }

    match /prosby/{pid} {
      allow get, list: if zalogowany() && (resource.data.uid == request.auth.uid || wlascicielDrzewa(resource.data.drzewoId)) || jestAdmin();
      allow create, update: if weryfikowany() && prosbaPoprawna(pid, request.resource.data);
      allow delete: if zalogowany() && (resource.data.uid == request.auth.uid || wlascicielDrzewa(resource.data.drzewoId)) || jestAdmin();
    }

    // ── drzewa ──
    function czlonek(m) { return zalogowany() && (m.wlascicielId == request.auth.uid || request.auth.uid in m.kolaboranci); }

    function metaPoprawna(m) {
      return m.keys().hasOnly(['nazwa', 'opis', 'region', 'widocznosc', 'politykaDatZyjacych', 'wlascicielId', 'wlascicielNazwa',
                               'kolaboranci', 'kolaboranciInfo', 'zakresLat', 'statystyki', 'utworzono', 'zaktualizowano', 'numer', 'nazwiska'])
        && (!('numer' in m) || (m.numer is string && numerPoprawny(m.numer)))
        && (!('nazwiska' in m) || (m.nazwiska is list && m.nazwiska.size() <= 300))
        && m.keys().hasAll(['nazwa', 'opis', 'region', 'widocznosc', 'politykaDatZyjacych', 'wlascicielId', 'wlascicielNazwa',
                            'kolaboranci', 'kolaboranciInfo', 'zakresLat', 'statystyki', 'utworzono', 'zaktualizowano'])
        && niepusty(m.nazwa, 120) && tekst(m.opis, 1000) && tekst(m.region, 120)
        && m.widocznosc in ['publiczne', 'prywatne']
        && m.politykaDatZyjacych in ['ukryj', 'tylko-rok', 'pokaz']
        && tekst(m.wlascicielId, 128) && tekst(m.wlascicielNazwa, 170)
        && m.kolaboranci is list && m.kolaboranci.size() <= 20
        && m.kolaboranciInfo is map && m.statystyki is map
        && (m.zakresLat == null || m.zakresLat is map)
        && tekst(m.utworzono, 40) && tekst(m.zaktualizowano, 40);
    }

    // ── numery drzew ──
    // Krótki numer (np. 48213) zastępuje długi identyfikator przy zapraszaniu do współpracy. Dokument numery/{numer}
    // wskazuje drzewo; powstaje wyłącznie razem z wpisaniem tego numeru do drzewa (batch), dla własnego drzewa bez numeru.
    function numerPoprawny(n) { return n.matches('[1-9][0-9]{4,8}'); }
    function drzewoDlaNumeru(d) { return get(/databases/$(database)/documents/drzewa/$(d)).data; }

    match /numery/{n} {
      allow get: if zalogowany();
      allow list, update: if false;
      allow create: if weryfikowany() && numerPoprawny(n)
        && request.resource.data.keys().hasOnly(['drzewoId'])
        && tekst(request.resource.data.drzewoId, 128)
        && (jestAdmin() || drzewoDlaNumeru(request.resource.data.drzewoId).wlascicielId == request.auth.uid)
        && !('numer' in drzewoDlaNumeru(request.resource.data.drzewoId))
        && getAfter(/databases/$(database)/documents/drzewa/$(request.resource.data.drzewoId)).data.numer == n;
      allow delete: if jestAdmin() || (weryfikowany() && (!exists(/databases/$(database)/documents/drzewa/$(resource.data.drzewoId))
        || drzewoDlaNumeru(resource.data.drzewoId).wlascicielId == request.auth.uid));
    }

    match /drzewa/{id} {
      allow get, list: if resource.data.widocznosc == 'publiczne' || czlonek(resource.data) || jestAdmin();

      allow create: if weryfikowany() && metaPoprawna(request.resource.data) && !('numer' in request.resource.data)
        && request.resource.data.wlascicielId == request.auth.uid
        && request.resource.data.kolaboranci.size() == 0;

      // Właściciel i administrator zmieniają wszystko oprócz właściciela; kolaborant tylko statystyki po edycji osób
      // albo opuszcza drzewo. Właściciel może przekazać drzewo wyłącznie jednemu ze swoich kolaborantów.
      // Numer można tylko nadać (raz) razem z dokumentem numery/{numer}, nigdy zmienić ani usunąć.
      allow update: if metaPoprawna(request.resource.data)
        && (request.resource.data.get('numer', '') == resource.data.get('numer', '')
            || (!('numer' in resource.data) && getAfter(/databases/$(database)/documents/numery/$(request.resource.data.numer)).data.drzewoId == id))
        && ((request.resource.data.wlascicielId == resource.data.wlascicielId
            && (jestAdmin()
                || (weryfikowany() && resource.data.wlascicielId == request.auth.uid)
                || (weryfikowany() && request.auth.uid in resource.data.kolaboranci
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['zakresLat', 'statystyki', 'nazwiska', 'zaktualizowano']))
                // kolaborant może opuścić drzewo (usunąć wyłącznie siebie)
                || (zalogowany() && request.auth.uid in resource.data.kolaboranci
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kolaboranci', 'kolaboranciInfo'])
                    && !(request.auth.uid in request.resource.data.kolaboranci)
                    && request.resource.data.kolaboranci.size() == resource.data.kolaboranci.size() - 1
                    && request.resource.data.kolaboranci.hasAll(resource.data.kolaboranci.removeAll([request.auth.uid])))))
            || (weryfikowany() && resource.data.wlascicielId == request.auth.uid
                && request.resource.data.wlascicielId in resource.data.kolaboranci
                && !(request.resource.data.wlascicielId in request.resource.data.kolaboranci)));

      allow delete: if jestAdmin() || (weryfikowany() && resource.data.wlascicielId == request.auth.uid);

      match /dane/{wersja} {
        function meta() { return get(/databases/$(database)/documents/drzewa/$(id)).data; }

        allow get: if (wersja == 'publiczne' && (meta().widocznosc == 'publiczne' || czlonek(meta()) || jestAdmin()))
                   || (wersja == 'pelne' && (czlonek(meta()) || jestAdmin()));
        allow list: if false;

        allow create, update: if (wersja == 'pelne' || wersja == 'publiczne')
          && (jestAdmin() || (weryfikowany() && czlonek(meta())))
          && request.resource.data.keys().hasOnly(['galezie', 'osoby', 'malzenstwa'])
          && request.resource.data.galezie is list && request.resource.data.osoby is list && request.resource.data.malzenstwa is list
          && request.resource.data.osoby.size() <= 2000 && request.resource.data.galezie.size() <= 100;

        allow delete: if jestAdmin() || (weryfikowany() && meta().wlascicielId == request.auth.uid);
      }
    }
  }
}
