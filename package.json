{
  "name": "drzewo-genealogiczne",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/waliduj.ts",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "import": "tsx scripts/import.ts",
    "waliduj": "tsx scripts/waliduj.ts",
    "generuj-testowe": "tsx scripts/generuj-testowe.ts",
    "kontrast": "node scripts/kontrast.mjs",
    "zastosuj-edycje": "tsx scripts/zastosuj-edycje.ts",
    "zastosuj-zmiany-drzew": "tsx scripts/zastosuj-zmiany-drzew.ts",
    "test:reguly": "firebase emulators:exec --only firestore --project przodkowie-test \"vitest run --config vitest.reguly.config.ts\"",
    "test:e2e": "NEXT_PUBLIC_FIREBASE_EMULATOR=1 npm run build && firebase emulators:exec --only auth,firestore --project przodkowie-test \"node tests/e2e/uruchom.cjs\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@xyflow/react": "^12.12.1",
    "d3-flextree": "^2.1.2",
    "d3-hierarchy": "^3.1.3",
    "firebase": "^13.3.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
